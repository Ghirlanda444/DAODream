(fn TakeAttack (InAttack InMin InMax InScale InThreshold)
  (Utilità|ControlloDiFlusso|Ramo (Variabili|Predefinito|OttieniDead)
    (:else
      (Classe|BPPlotManager|PlayerStrike (Variabili|Predefinito|OttieniMgr) :Target (Variabili|Ottieniunriferimentoasestesso) :Def (Utility|Operatori|Aggiungi (Utility|Operatori|Aggiungi (Variabili|Predefinito|OttieniDefense) (Variabili|Predefinito|OttieniNOwnDef)) (Matematica|Float|SelectFloat (Variabili|Predefinito|OttieniNDefAdd) 0.0 (Utility|Operatori|Maggiore(>) (Variabili|Predefinito|OttieniNDefUntil) (Utilità|Testo|GetGameTimeinSeconds)))) :Armour (Utility|Operatori|Aggiungi (Utility|Operatori|Aggiungi (Variabili|Predefinito|OttieniArmour) (Variabili|Predefinito|OttieniNOwnArmour)) (Matematica|Float|SelectFloat (Variabili|Predefinito|OttieniNArmourAdd) 0.0 (Utility|Operatori|Maggiore(>) (Variabili|Predefinito|OttieniNArmourUntil) (Utilità|Testo|GetGameTimeinSeconds))))))))
