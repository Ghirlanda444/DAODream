(fn TakeStrike (Attacker InAttack InMin InMax InScale InCrit InPen InBonus InFlank)
  (Utilità|ControlloDiFlusso|Ramo (Variabili|Predefinito|OttieniDead)
    (:else
      (Classe|BPPlotManager|StrikeNpc (Variabili|Predefinito|OttieniMgr) :Attacker Attacker :Target (Variabili|Ottieniunriferimentoasestesso) :Atk InAttack :Def (Utility|Operatori|Aggiungi (Utility|Operatori|Aggiungi (Variabili|Predefinito|OttieniDefense) (Variabili|Predefinito|OttieniNOwnDef)) (Matematica|Float|SelectFloat (Variabili|Predefinito|OttieniNDefAdd) 0.0 (Utility|Operatori|Maggiore(>) (Variabili|Predefinito|OttieniNDefUntil) (Utilità|Testo|GetGameTimeinSeconds)))) :DmgMin InMin :DmgMax InMax :Scale InScale :Crit InCrit :Pen InPen :Bonus InBonus :Flank InFlank :Armour (Utility|Operatori|Aggiungi (Utility|Operatori|Aggiungi (Variabili|Predefinito|OttieniArmour) (Variabili|Predefinito|OttieniNOwnArmour)) (Matematica|Float|SelectFloat (Variabili|Predefinito|OttieniNArmourAdd) 0.0 (Utility|Operatori|Maggiore(>) (Variabili|Predefinito|OttieniNArmourUntil) (Utilità|Testo|GetGameTimeinSeconds))))))))
