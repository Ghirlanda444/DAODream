(fn StagePlace (K I)
  (bind _f (Variabili|Predefinito|OttieniStageFrames))
  (bind _at (Utility|Operatori|Moltiplica (Utility|Operatori|Aggiungi (Utility|Operatori|Moltiplica K (Variabili|Predefinito|OttieniStageN)) I) 4))
  (bind _loc (Matematica|Vettore|MakeVector (Utilità|Array|Ottieni(unacopia) _f _at) (Utilità|Array|Ottieni(unacopia) _f (Utility|Operatori|Aggiungi _at 1)) (Utilità|Array|Ottieni(unacopia) _f (Utility|Operatori|Aggiungi _at 2))))
  (bind _rot (Matematica|Rotatore|MakeRotator 0.0 0.0 (Utilità|Array|Ottieni(unacopia) _f (Utility|Operatori|Aggiungi _at 3))))
  (bind _tag (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniStageTags) K))
  (Utilità|ControlloDiFlusso|Ramo (Utilità|Stringa|EqualExactly(String) _tag "PLAYER")
    (:then (Trasformazione|SetActorLocationAndRotation (Gioco|GetPlayerPawn 0) (Utility|Operatori|Aggiungi _loc (Matematica|Vettore|MakeVector 0.0 0.0 90.0)) _rot "false" "true"))
    (:else (Funzionedichiamata|StageNpc :Tag _tag :Loc _loc :Rot _rot))))
