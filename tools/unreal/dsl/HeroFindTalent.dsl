(fn HeroFindTalent (K Sub)
  (Utilità|ControlloDiFlusso|Ramo (Matematica|Booleano|ANDBoolean (Utility|Operatori|Minore(<) (Variabili|Predefinito|OttieniHTFound) 0) (Utility|Operatori|Uguale(==) (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniTalents) (Utility|Operatori|Moltiplica K 18)) Sub))
    (:then
      (Variabili|Predefinito|ImpostaHTFound K))))
