(fn Inspect (Npc Asker)
  (Classe|BPDlgNPC|TakeState Asker :bOk (Matematica|Booleano|ANDBoolean (Matematica|Booleano|NOTBoolean (Classe|BPDlgNPC|OttieniDead Npc)) (Matematica|Booleano|NOTBoolean (Classe|BPDlgNPC|OttieniDown Npc))) :Hp (Utility|Operatori|Dividi (Classe|BPDlgNPC|OttieniHealth Npc) (Matematica|Float|Max(Float) (Classe|BPDlgNPC|OttieniMaxHealth Npc) 1.0)) :SeenAmt (Classe|BPDlgNPC|OttieniSeen Npc) :Mul (Matematica|Float|SelectFloat 0.8 1.0 (Classe|BPDlgNPC|OttieniRogueN Npc)) :bParty (Classe|BPDlgNPC|OttieniInParty Npc)))
