(fn AroundPlayer ()
  (Utilità|ControlloDiFlusso|Ramo (Matematica|Booleano|ANDBoolean (Matematica|Booleano|NOTBoolean (Variabili|Predefinito|OttieniInParty)) (Utility|Operatori|Minore(<) (Trasformazione|GetDistanceTo (Variabili|Ottieniunriferimentoasestesso) (Gioco|GetPlayerPawn 0)) 250.0))
    (:then
      (Classe|BPPlotManager|AroundOne (Variabili|Predefinito|OttieniMgr)))))
