(fn RegenTick ()
  (Utilità|ControlloDiFlusso|Ramo (Matematica|Booleano|ORBoolean (Variabili|Predefinito|OttieniGameOver) (Utility|Operatori|Minore(<) (Utility|Operatori|Sottrai (Utilità|Testo|GetGameTimeinSeconds) (Variabili|Predefinito|OttieniLastCombat)) 4.0))
    (:else
      (Funzionedichiamata|RevivePlayer)
      (Funzionedichiamata|ReviveMembers)
      (Funzionedichiamata|RegenAll))))
