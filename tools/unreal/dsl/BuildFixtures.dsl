(fn BuildFixtures ()
  (bind _path (Utilità|Stringa|Append (Utilità|Stringa|Append (Utilità|Percorsi|GetProjectDirectory) "../../extracted/ue/areas/") (Utilità|Stringa|Append (Variabili|Predefinito|OttieniAreaName) ".json")))
  (bind _json (Json|LoadJsonfromFile (Utilità|Struttura|MakeFilePath _path)))
  (Variabili|Predefinito|ImpostaFixtures (Json|GetField _json "Fixtures"))
  (Variabili|Predefinito|ImpostaFires (Json|GetField _json "Fires"))
  (Variabili|Predefinito|ImpostaNpcChest (Json|GetField _json "NpcChest"))
  (Variabili|Predefinito|ImpostaNpcHelmet (Json|GetField _json "NpcHelmet"))
  (Variabili|Predefinito|ImpostaNpcIdle (Json|GetField _json "NpcIdle"))
  (Variabili|Predefinito|ImpostaNpcVariety (Json|GetField _json "NpcVariety"))
  (Variabili|Predefinito|ImpostaNpcRules (Json|GetField _json "NpcRules"))
  (Variabili|Predefinito|ImpostaNpcInterval (Json|GetField _json "NpcInterval"))
  (Variabili|Predefinito|ImpostaNpcStatus (Json|GetField _json "NpcStatus"))
  (Variabili|Predefinito|ImpostaNpcTalents (Json|GetField _json "NpcTalents"))
  (Variabili|Predefinito|ImpostaNpcTactics (Json|GetField _json "NpcTactics"))
  (Variabili|Predefinito|ImpostaNpcSpell (Json|GetField _json "NpcSpell"))
  (Variabili|Predefinito|ImpostaPlayerTalents (Json|GetField _json "PlayerTalents"))
  (Variabili|Predefinito|ImpostaPlayerPassives (Json|GetField _json "PlayerPassives"))
  (Variabili|Predefinito|ImpostaPlayerTalentNames (Json|GetField _json "PlayerTalentNames"))
  (Variabili|Predefinito|ImpostaPlayerTactics (Json|GetField _json "PlayerTactics"))
  (Funzionedichiamata|GiveTalents)
  (Variabili|Predefinito|ImpostaKitMeshes (Json|GetField _json "KitMeshes"))
  (Variabili|Predefinito|ImpostaKitPlaced (Json|GetField _json "KitPlaced"))
  (Funzionedichiamata|SpawnFixtureMeshes)
  (Funzionedichiamata|SpawnKitMeshes)
  (Funzionedichiamata|SpawnFires)
  (Funzionedichiamata|StartFlicker))
