(fn JoinRows ()
  (Utilità|ControlloDiFlusso|Ramo (Utility|Operatori|Maggiore(>) (Variabili|Predefinito|OttieniTacticSlots) 0)
    (:then
      (Variabili|Predefinito|ImpostaAiTactics (Variabili|Predefinito|OttieniNTactics))
      (Variabili|Predefinito|ImpostaNTactics (Variabili|Predefinito|OttieniPartyTactics))
      (Variabili|Predefinito|ImpostaPartyRows "true"))))
