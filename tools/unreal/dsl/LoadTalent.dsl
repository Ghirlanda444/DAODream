(fn LoadTalent (Slot)
  (Variabili|Predefinito|ImpostaTSlot Slot)
  (Variabili|Predefinito|ImpostaTId (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniTalents) (Utility|Operatori|Aggiungi (Utility|Operatori|Moltiplica Slot 18) 0)))
  (Variabili|Predefinito|ImpostaTUse (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniTalents) (Utility|Operatori|Aggiungi (Utility|Operatori|Moltiplica Slot 18) 1)))
  (Variabili|Predefinito|ImpostaTCost (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniTalents) (Utility|Operatori|Aggiungi (Utility|Operatori|Moltiplica Slot 18) 2)))
  (Variabili|Predefinito|ImpostaTCool (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniTalents) (Utility|Operatori|Aggiungi (Utility|Operatori|Moltiplica Slot 18) 3)))
  (Variabili|Predefinito|ImpostaTUpkeep (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniTalents) (Utility|Operatori|Aggiungi (Utility|Operatori|Moltiplica Slot 18) 4)))
  (Variabili|Predefinito|ImpostaTFatigue (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniTalents) (Utility|Operatori|Aggiungi (Utility|Operatori|Moltiplica Slot 18) 5)))
  (Variabili|Predefinito|ImpostaTAtkBonus (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniTalents) (Utility|Operatori|Aggiungi (Utility|Operatori|Moltiplica Slot 18) 6)))
  (Variabili|Predefinito|ImpostaTSeconds (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniTalents) (Utility|Operatori|Aggiungi (Utility|Operatori|Moltiplica Slot 18) 7))))
