(fn EndFeignSlot (Slot)
  (Utilità|ControlloDiFlusso|Ramo (Matematica|Booleano|ANDBoolean (Utility|Operatori|Uguale(==) (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniTalents) (Utility|Operatori|Moltiplica Slot 18)) 3023.0) (Utility|Operatori|Maggiore(>) (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniTUntil) Slot) 0.0))
    (:then
      (Funzionedichiamata|LoadTalent :Slot Slot)
      (Funzionedichiamata|ToggleSustained))))
