(fn Retarget (Changed)
  (Funzionedichiamata|MostHated)
  (Utilità|ControlloDiFlusso|Ramo (Matematica|Booleano|NOTBoolean (Utilità|IsValid (Variabili|Predefinito|OttieniFoe)))
    (:then
      (Variabili|Predefinito|ImpostaFoe (Variabili|Predefinito|OttieniHated))
      (Variabili|Predefinito|ImpostaTSwitched (Utilità|Testo|GetGameTimeinSeconds)))
    (:else
      (Utilità|ControlloDiFlusso|Ramo (Utility|Operatori|Uguale(==) (Variabili|Predefinito|OttieniHated) (Variabili|Predefinito|OttieniFoe))
        (:else
          (Funzionedichiamata|MaySwitch :Changed Changed))))))
