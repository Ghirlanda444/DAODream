(fn TacTooFar ()
  (Utilità|ControlloDiFlusso|Ramo (Utility|Operatori|Maggiore(>) (Trasformazione|GetHorizontalDistanceTo (Variabili|Ottieniunriferimentoasestesso) (Variabili|Predefinito|OttieniTacWho)) (Matematica|Float|SelectFloat 1500.0 (Matematica|Float|SelectFloat (Utility|Operatori|Moltiplica (Variabili|Predefinito|OttieniNRange) 100.0) 250.0 (Utility|Operatori|Maggiore(>) (Variabili|Predefinito|OttieniNRange) 0.0)) (Variabili|Predefinito|OttieniStaff)))
    (:then
