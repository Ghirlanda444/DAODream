(fn TrWound (K)
  (Funzionedichiamata|TrPeek :A (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniCL) K))
  (Utilità|ControlloDiFlusso|Ramo (Utility|Operatori|Minore(<) (Variabili|Predefinito|OttieniPkHp) (Variabili|Predefinito|OttieniPkMax))
    (:then
      (Utilità|Array|Add (Variabili|Predefinito|OttieniCL2) (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniCL) K)))))
