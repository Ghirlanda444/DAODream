(fn SupportRound ()
  (Classe|BPPlotManager|TrGather (Variabili|Predefinito|OttieniMgr) :Me (Variabili|Ottieniunriferimentoasestesso))
  (Utilità|ControlloDiFlusso|Ramo (Utility|Operatori|Maggiore(>) (Utilità|Array|Length (Classe|BPPlotManager|OttieniEnAll (Variabili|Predefinito|OttieniMgr))) 0)
    (:then
      (Funzionedichiamata|Behave)
      (Funzionedichiamata|SupportGo))))
