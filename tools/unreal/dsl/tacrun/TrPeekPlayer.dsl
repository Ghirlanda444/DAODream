(fn TrPeekPlayer ()
  (Variabili|Predefinito|ImpostaPkAlive (Matematica|Booleano|NOTBoolean (Matematica|Booleano|ORBoolean (Variabili|Predefinito|OttieniPlayerDown) (Variabili|Predefinito|OttieniGameOver))))
  (Variabili|Predefinito|ImpostaPkVis "true")
  (Variabili|Predefinito|ImpostaPkSide 0)
  (Variabili|Predefinito|ImpostaPkHp (Variabili|Predefinito|OttieniPlayerHealth))
  (Variabili|Predefinito|ImpostaPkMax (Matematica|Float|Max(Float) (Variabili|Predefinito|OttieniPlayerMaxHealth) 1.0))
  (Variabili|Predefinito|ImpostaPkPct (Utility|Operatori|Moltiplica (Utility|Operatori|Dividi (Variabili|Predefinito|OttieniPkHp) (Variabili|Predefinito|OttieniPkMax)) 100.0))
  (Variabili|Predefinito|ImpostaPkSta (Utility|Operatori|Moltiplica (Utility|Operatori|Dividi (Variabili|Predefinito|OttieniPStamina) (Matematica|Float|Max(Float) (Variabili|Predefinito|OttieniPPool) 1.0)) 100.0))
  (Variabili|Predefinito|ImpostaPkTgt (Variabili|Predefinito|OttieniHeroTarget))
  (Variabili|Predefinito|ImpostaPkAtk (Matematica|Intero|SelectInt 2 1 (Variabili|Predefinito|OttieniBowOn)))
  (Variabili|Predefinito|ImpostaPkStun (Matematica|Booleano|ANDBoolean (Utility|Operatori|Maggiore(>) (Variabili|Predefinito|OttieniPStunUntil) (Utilità|Testo|GetGameTimeinSeconds)) (Matematica|Booleano|NOTBoolean (Variabili|Predefinito|OttieniPFall))))
  (Variabili|Predefinito|ImpostaPkKnock (Matematica|Booleano|ANDBoolean (Utility|Operatori|Maggiore(>) (Variabili|Predefinito|OttieniPStunUntil) (Utilità|Testo|GetGameTimeinSeconds)) (Variabili|Predefinito|OttieniPFall)))
  (Variabili|Predefinito|ImpostaPkRoot (Utility|Operatori|Maggiore(>) (Variabili|Predefinito|OttieniPRootUntil) (Utilità|Testo|GetGameTimeinSeconds)))
  (Variabili|Predefinito|ImpostaPkLoc (Trasformazione|GetActorLocation (Gioco|GetPlayerPawn 0)))
  (Funzionedichiamata|TrTraits :T (Variabili|Predefinito|OttieniPTraits)))
