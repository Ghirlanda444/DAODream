(fn TrMember ()
  (Variabili|Predefinito|ImpostaPkMem)
  (Utilità|ControlloDiFlusso|Ramo (Utility|Operatori|Uguale(==) (Variabili|Predefinito|OttieniTP) 5.0)
    (:then
      (Variabili|Predefinito|ImpostaPkMem (Gioco|GetPlayerPawn 0)))
    (:else
  (Utilità|ControlloDiFlusso|Ramo (Utility|Operatori|Uguale(==) (Variabili|Predefinito|OttieniTP) 18.0)
    (:then
      (Variabili|Predefinito|ImpostaPkMem (Variabili|Predefinito|OttieniTCtrl)))))))
