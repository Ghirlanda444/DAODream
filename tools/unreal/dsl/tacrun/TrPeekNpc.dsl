(fn TrPeekNpc (N)
  (Variabili|Predefinito|ImpostaPkAlive (Matematica|Booleano|ANDBoolean (Matematica|Booleano|NOTBoolean (Classe|BPDlgNPC|OttieniDead N)) (Matematica|Booleano|NOTBoolean (Classe|BPDlgNPC|OttieniDown N))))
  (Classe|BPDlgNPC|HidCheck N)
  (Variabili|Predefinito|ImpostaPkVis (Matematica|Booleano|NOTBoolean (Classe|BPDlgNPC|OttieniHid N)))
  (Variabili|Predefinito|ImpostaPkSide (Matematica|Intero|SelectInt 0 (Matematica|Intero|SelectInt 1 (Matematica|Intero|SelectInt 2 -1 (Classe|BPDlgNPC|OttieniAllyOn N)) (Classe|BPDlgNPC|OttieniHostile N)) (Classe|BPDlgNPC|OttieniInParty N)))
  (Variabili|Predefinito|ImpostaPkHp (Classe|BPDlgNPC|OttieniHealth N))
  (Variabili|Predefinito|ImpostaPkMax (Matematica|Float|Max(Float) (Classe|BPDlgNPC|OttieniMaxHealth N) 1.0))
  (Variabili|Predefinito|ImpostaPkPct (Utility|Operatori|Moltiplica (Utility|Operatori|Dividi (Variabili|Predefinito|OttieniPkHp) (Variabili|Predefinito|OttieniPkMax)) 100.0))
  (Variabili|Predefinito|ImpostaPkSta (Utility|Operatori|Moltiplica (Utility|Operatori|Dividi (Classe|BPDlgNPC|OttieniNStamina N) (Matematica|Float|Max(Float) (Classe|BPDlgNPC|OttieniNPool N) 1.0)) 100.0))
  (Variabili|Predefinito|ImpostaPkTgt (Classe|BPDlgNPC|OttieniFoe N))
  (Variabili|Predefinito|ImpostaPkAtk (Matematica|Intero|SelectInt 4 (Matematica|Intero|SelectInt 2 1 (Utility|Operatori|Maggiore(>) (Classe|BPDlgNPC|OttieniNRange N) 0.0)) (Classe|BPDlgNPC|OttieniStaff N)))
  (Variabili|Predefinito|ImpostaPkStun (Utility|Operatori|Maggiore(>) (Classe|BPDlgNPC|OttieniStunUntil N) (Utilità|Testo|GetGameTimeinSeconds)))
  (Variabili|Predefinito|ImpostaPkKnock (Utility|Operatori|Maggiore(>) (Classe|BPDlgNPC|OttieniKnockUntil N) (Utilità|Testo|GetGameTimeinSeconds)))
  (Variabili|Predefinito|ImpostaPkRoot (Utility|Operatori|Maggiore(>) (Classe|BPDlgNPC|OttieniRootUntil N) (Utilità|Testo|GetGameTimeinSeconds)))
  (Variabili|Predefinito|ImpostaPkSlow (Utility|Operatori|Maggiore(>) (Classe|BPDlgNPC|OttieniSlowUntil N) (Utilità|Testo|GetGameTimeinSeconds)))
  (Variabili|Predefinito|ImpostaPkLoc (Trasformazione|GetActorLocation N))
  (Funzionedichiamata|TrTraits :T (Classe|BPDlgNPC|OttieniNTraits N)))
