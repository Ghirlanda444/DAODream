(fn TrTraits (T)
  (Utilità|ControlloDiFlusso|Ramo (Utility|Operatori|Maggioreuguale(>=) (Utilità|Array|Length T) 5)
    (:then
      (Variabili|Predefinito|ImpostaPkClass (Matematica|Float|Truncate (Utilità|Array|Ottieni(unacopia) T 0)))
      (Variabili|Predefinito|ImpostaPkRace (Matematica|Float|Truncate (Utilità|Array|Ottieni(unacopia) T 1)))
      (Variabili|Predefinito|ImpostaPkGender (Matematica|Float|Truncate (Utilità|Array|Ottieni(unacopia) T 2)))
      (Variabili|Predefinito|ImpostaPkRank (Matematica|Float|Truncate (Utilità|Array|Ottieni(unacopia) T 3)))
      (Variabili|Predefinito|ImpostaPkArmor (Matematica|Float|Truncate (Utilità|Array|Ottieni(unacopia) T 4))))))
