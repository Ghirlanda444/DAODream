(fn TrPeek (A)
  (Variabili|Predefinito|ImpostaPkAlive "false")
  (Variabili|Predefinito|ImpostaPkVis "false")
  (Variabili|Predefinito|ImpostaPkSide -1)
  (Variabili|Predefinito|ImpostaPkTgt)
  (Variabili|Predefinito|ImpostaPkAtk 1)
  (Variabili|Predefinito|ImpostaPkHp 0.0)
  (Variabili|Predefinito|ImpostaPkMax 1.0)
  (Variabili|Predefinito|ImpostaPkPct 0.0)
  (Variabili|Predefinito|ImpostaPkSta 0.0)
  (Variabili|Predefinito|ImpostaPkStun "false")
  (Variabili|Predefinito|ImpostaPkKnock "false")
  (Variabili|Predefinito|ImpostaPkRoot "false")
  (Variabili|Predefinito|ImpostaPkSlow "false")
  (Variabili|Predefinito|ImpostaPkClass 0)
  (Variabili|Predefinito|ImpostaPkRace 0)
  (Variabili|Predefinito|ImpostaPkGender 0)
  (Variabili|Predefinito|ImpostaPkRank 0)
  (Variabili|Predefinito|ImpostaPkArmor 0)
  (Utilità|ControlloDiFlusso|Ramo (Utility|Operatori|Uguale(==) A (Gioco|GetPlayerPawn 0))
    (:then
      (Funzionedichiamata|TrPeekPlayer))
    (:else
  (Utilità|ControlloDiFlusso|Ramo (Utilità|IsValid A)
    (:then
      (Funzionedichiamata|TrPeekCast :A A))))))
