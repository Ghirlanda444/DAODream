(fn Behave ()
  (Funzionedichiamata|NFlag :Fl 5)
  (Utilità|ControlloDiFlusso|Ramo (Matematica|Booleano|ANDBoolean (Variabili|Predefinito|OttieniBFlag) (Utility|Operatori|Maggiore(>) (Utilità|Array|Length (Classe|BPPlotManager|OttieniEnD (Variabili|Predefinito|OttieniMgr))) 0))
    (:then
  (Utilità|ControlloDiFlusso|Ramo (Utility|Operatori|Minore(<) (Utilità|Array|Ottieni(unacopia) (Classe|BPPlotManager|OttieniEnD (Variabili|Predefinito|OttieniMgr)) 0) 350.0)
    (:then
      (Funzionedichiamata|BackAway :From (Utilità|Array|Ottieni(unacopia) (Classe|BPPlotManager|OttieniEnL (Variabili|Predefinito|OttieniMgr)) 0)))))
    (:else
      (Funzionedichiamata|BehaveMelee))))
