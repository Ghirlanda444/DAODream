(fn TrGather (Me)
  (Utilità|Array|Clear (Variabili|Predefinito|OttieniAllyL))
  (Utilità|Array|Clear (Variabili|Predefinito|OttieniAllyD))
  (Utilità|Array|Clear (Variabili|Predefinito|OttieniEnL))
  (Utilità|Array|Clear (Variabili|Predefinito|OttieniEnD))
  (Utilità|Array|Clear (Variabili|Predefinito|OttieniEnAll))
  (Utilità|Array|Clear (Variabili|Predefinito|OttieniNearD))
  (Utilità|Array|Clear (Variabili|Predefinito|OttieniNearDead))
  (Variabili|Predefinito|ImpostaRingN 0)
  (Variabili|Predefinito|ImpostaDeadN 0)
  (Variabili|Predefinito|ImpostaTMe Me)
  (Funzionedichiamata|TrPeek :A Me)
  (Variabili|Predefinito|ImpostaTMeSide (Variabili|Predefinito|OttieniPkSide))
  (Variabili|Predefinito|ImpostaTMeTgt (Variabili|Predefinito|OttieniPkTgt))
  (Variabili|Predefinito|ImpostaTMeParty (Utility|Operatori|Uguale(==) (Variabili|Predefinito|OttieniPkSide) 0))
  (Funzionedichiamata|TrCtrl)
  (Funzionedichiamata|TrMeInfo :A Me)
  (Funzionedichiamata|TrFlag :B (Variabili|Predefinito|OttieniTMeBeh) :Fl 1)
  (Variabili|Predefinito|ImpostaTMeChase (Variabili|Predefinito|OttieniBF))
  (bind _all (Attore|GetAllActorsOfClass "/Game/Cousland/Dialogue/BP_DlgNPC.BP_DlgNPC_C"))
  (for _a _all
    (Funzionedichiamata|TrGatherOne :A _a))
  (Funzionedichiamata|TrGatherOne :A (Gioco|GetPlayerPawn 0))
  (Funzionedichiamata|TrCutEn5)
  (Funzionedichiamata|TrCutAlly5)
  (Funzionedichiamata|TrCountDead)
  (Funzionedichiamata|TrEngage))
