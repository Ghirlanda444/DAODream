(fn UseTalent (Slot)
  (Utilità|ControlloDiFlusso|Ramo (Matematica|Booleano|ORBoolean (Matematica|Booleano|ORBoolean (Variabili|Predefinito|OttieniTalking) (Variabili|Predefinito|OttieniGameOver)) (Matematica|Booleano|ORBoolean (Variabili|Predefinito|OttieniPlayerDown) (Utility|Operatori|Maggioreuguale(>=) Slot (Utilità|Array|Length (Variabili|Predefinito|OttieniTalentNames)))))
    (:else
      (Funzionedichiamata|TalentCheck :Slot Slot))))
