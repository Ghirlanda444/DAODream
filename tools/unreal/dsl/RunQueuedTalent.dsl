(fn RunQueuedTalent ()
  (Utilità|ControlloDiFlusso|Ramo (Utility|Operatori|Maggiore(>) (Variabili|Predefinito|OttieniQueuedSlot) 0)
    (:then
      (Funzionedichiamata|UseTalentNow :Slot (Utility|Operatori|Sottrai (Variabili|Predefinito|OttieniQueuedSlot) 1))
      (Variabili|Predefinito|ImpostaQueuedSlot 0))))
