(fn Recover ()
  (Utilità|ControlloDiFlusso|Ramo (Matematica|Booleano|ANDBoolean (Variabili|Predefinito|OttieniKnocked) (Utility|Operatori|Minoreuguale(<=) (Variabili|Predefinito|OttieniKnockUntil) (Utilità|Testo|GetGameTimeinSeconds)))
    (:then
      (Variabili|Predefinito|ImpostaKnocked "false")
      (Componenti|Animazione|PlayAnimation (Variabili|Predefinito|OttieniMesh) "/Game/Characters/Mannequins/Anims/Unarmed/MM_Idle.MM_Idle" "true"))))
