(fn Setup (InLook InName bLocked InLevel InKey bKeyReq bUsable)
  (Variabili|Predefinito|ImpostaLook InLook)
  (Variabili|Predefinito|ImpostaCName InName)
  (Variabili|Predefinito|ImpostaLocked bLocked)
  (Variabili|Predefinito|ImpostaLockLevel InLevel)
  (Variabili|Predefinito|ImpostaKeyTag InKey)
  (Variabili|Predefinito|ImpostaKeyReq bKeyReq)
  (Variabili|Predefinito|ImpostaUsable bUsable)
  (bind _m (Attore|GetComponentbyClass (Variabili|Ottieniunriferimentoasestesso) "/Script/Engine.StaticMeshComponent"))
  (bind _sm (Utilità|Casting|CastToStaticMeshComponent _m))
  (Componenti|StaticMesh|SetStaticMesh _sm (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniMeshes) InLook))
  (Trasformazione|SetRelativeScale3D _sm (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniScales) InLook)))
