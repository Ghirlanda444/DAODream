(fn InvFindOne (K Item)
  (Utilità|ControlloDiFlusso|Ramo (Matematica|Booleano|ANDBoolean (Utility|Operatori|Minore(<) (Variabili|Predefinito|OttieniInvAt) 0) (Utility|Operatori|Uguale(==) (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniInv) K) Item))
    (:then
      (Variabili|Predefinito|ImpostaInvAt K))))
