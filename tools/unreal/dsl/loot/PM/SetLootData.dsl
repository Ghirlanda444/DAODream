(fn SetLootData (InTags InNames InDescs InStats InRanges InRows InBag InRules InReactive InLockpick InSpell InPlayerItems)
  (Variabili|Predefinito|ImpostaItemTags InTags)
  (Variabili|Predefinito|ImpostaItemNames InNames)
  (Variabili|Predefinito|ImpostaItemDescs InDescs)
  (Variabili|Predefinito|ImpostaItemStats InStats)
  (Variabili|Predefinito|ImpostaTRanges InRanges)
  (Variabili|Predefinito|ImpostaTRows InRows)
  (Variabili|Predefinito|ImpostaLBag InBag)
  (Variabili|Predefinito|ImpostaLRules InRules)
  (Variabili|Predefinito|ImpostaLReactive InReactive)
  (Variabili|Predefinito|ImpostaPLockpick InLockpick)
  (Variabili|Predefinito|ImpostaPSpell InSpell)
  (Utilità|Array|Clear (Variabili|Predefinito|OttieniInv))
  (Utilità|Array|Clear (Variabili|Predefinito|OttieniInvN))
  (Variabili|Predefinito|ImpostaMoney 0)
  (Utilities|FlowControl|ForLoop :FirstIndex 0 :LastIndex (Utility|Operatori|Sottrai (Utility|Operatori|Dividi (Utilità|Array|Length InPlayerItems) 2) 1)
    (:LoopBody
      (Funzionedichiamata|PlayerItemOne :InPlayerItems InPlayerItems :K _index))))
