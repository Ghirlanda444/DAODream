(fn FillBox (Box InLoot K BStart BCount)
  (Funzionedichiamata|GenLoot :InLoot InLoot :O (Utility|Operatori|Moltiplica K 9) :BStart BStart :BCount BCount :bHost "false")
  (Classe|BPContainer|SetLoot Box :InItems (Variabili|Predefinito|OttieniGItems) :InCounts (Variabili|Predefinito|OttieniGCounts) :InMoney (Variabili|Predefinito|OttieniGMoney)))
