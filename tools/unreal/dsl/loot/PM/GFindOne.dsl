(fn GFindOne (K Item)
  (Utilità|ControlloDiFlusso|Ramo (Matematica|Booleano|ANDBoolean (Utility|Operatori|Minore(<) (Variabili|Predefinito|OttieniGAt) 0) (Utility|Operatori|Uguale(==) (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniGItems) K) Item))
    (:then
      (Variabili|Predefinito|ImpostaGAt K))))
