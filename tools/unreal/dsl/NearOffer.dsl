(fn NearOffer (InMgr)
  (Utilità|ControlloDiFlusso|Ramo (Matematica|Booleano|ANDBoolean (Matematica|Booleano|ANDBoolean (Variabili|Predefinito|OttieniHostile) (Matematica|Booleano|NOTBoolean (Variabili|Predefinito|OttieniDead))) (Matematica|Booleano|ANDBoolean (Matematica|Booleano|NOTBoolean (Variabili|Rendering|OttieniActorHiddenInGame)) (Utility|Operatori|Minore(<) (Trasformazione|GetDistanceTo (Variabili|Ottieniunriferimentoasestesso) (Gioco|GetPlayerPawn 0)) 250.0)))
    (:then
      (Classe|BPPlotManager|CountOne InMgr))))
