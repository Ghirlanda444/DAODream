(fn HeroTal (K)
  (Utilità|Array|Add (Variabili|Predefinito|OttieniTalIds) (Utilità|Array|Ottieni(unacopia) (Classe|BPPlotManager|OttieniTalents (Variabili|Predefinito|OttieniMgr)) (Utility|Operatori|Moltiplica K 18)))
  (Utilità|Array|Add (Variabili|Predefinito|OttieniTalUse) (Utilità|Array|Ottieni(unacopia) (Classe|BPPlotManager|OttieniTalents (Variabili|Predefinito|OttieniMgr)) (Utility|Operatori|Aggiungi (Utility|Operatori|Moltiplica K 18) 1)))
  (Utilità|Array|Add (Variabili|Predefinito|OttieniTalNames) (Utilità|Array|Ottieni(unacopia) (Classe|BPPlotManager|OttieniTalentNames (Variabili|Predefinito|OttieniMgr)) K)))
