(fn MoveUp (R)
  (Utilità|ControlloDiFlusso|Ramo (Matematica|Booleano|ANDBoolean (Utility|Operatori|Maggiore(>) R 0) (Utility|Operatori|Minore(<) R (Matematica|Intero|Min(Integer) (Variabili|Predefinito|OttieniSlots) 12)))
    (:then
      (Variabili|Predefinito|ImpostaEditRow R)
      (Funzionedichiamata|SwapRows))))
