(fn AddTalOpt (K)
  (Utilità|ControlloDiFlusso|Ramo (Matematica|Booleano|ORBoolean (Matematica|Booleano|ANDBoolean (Utility|Operatori|Uguale(==) (Variabili|Predefinito|OttieniCmdId) 4.0) (Matematica|Booleano|NOTBoolean (Utility|Operatori|Uguale(==) (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniTalUse) K) 2.0))) (Matematica|Booleano|ANDBoolean (Matematica|Booleano|ORBoolean (Utility|Operatori|Uguale(==) (Variabili|Predefinito|OttieniCmdId) 5.0) (Utility|Operatori|Uguale(==) (Variabili|Predefinito|OttieniCmdId) 6.0)) (Utility|Operatori|Uguale(==) (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniTalUse) K) 2.0)))
    (:then
      (Funzionedichiamata|AddOpt :Name (Utilità|Stringa|SelectString (Utilità|Stringa|Append "Deactivate: " (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniTalNames) K)) (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniTalNames) K) (Utility|Operatori|Uguale(==) (Variabili|Predefinito|OttieniCmdId) 6.0)) :Cmd (Variabili|Predefinito|OttieniCmdId) :Sub (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniTalIds) K)))))
