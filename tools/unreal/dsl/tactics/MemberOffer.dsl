(fn MemberOffer (A)
  (Utilità|ControlloDiFlusso|Ramo (Matematica|Booleano|ANDBoolean (Matematica|Booleano|ANDBoolean (Classe|BPDlgNPC|OttieniInParty A) (Matematica|Booleano|NOTBoolean (Classe|BPDlgNPC|OttieniDead A))) (Utility|Operatori|Minore(<) (Utilità|Array|Length (Variabili|Predefinito|OttieniMembers)) 3))
    (:then
      (Utilità|Array|Add (Variabili|Predefinito|OttieniMembers) A))))
