(fn NpcTal (K)
  (Utilità|ControlloDiFlusso|Ramo (Matematica|Booleano|ANDBoolean (Utility|Operatori|Minore(<) (Utility|Operatori|Moltiplica K 18) (Utilità|Array|Length (Classe|BPDlgNPC|OttieniNTalents (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniMembers) (Utility|Operatori|Sottrai (Variabili|Predefinito|OttieniMemberIdx) 1))))) (Utility|Operatori|Maggiore(>) (Utilità|Array|Ottieni(unacopia) (Classe|BPDlgNPC|OttieniNTalents (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniMembers) (Utility|Operatori|Sottrai (Variabili|Predefinito|OttieniMemberIdx) 1))) (Utility|Operatori|Moltiplica K 18)) 0.0))
    (:then
      (Classe|BPDlgNPC|NameOf (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniMembers) (Utility|Operatori|Sottrai (Variabili|Predefinito|OttieniMemberIdx) 1)) :K K)
      (Utilità|Array|Add (Variabili|Predefinito|OttieniTalIds) (Utilità|Array|Ottieni(unacopia) (Classe|BPDlgNPC|OttieniNTalents (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniMembers) (Utility|Operatori|Sottrai (Variabili|Predefinito|OttieniMemberIdx) 1))) (Utility|Operatori|Moltiplica K 18)))
      (Utilità|Array|Add (Variabili|Predefinito|OttieniTalUse) (Utilità|Array|Ottieni(unacopia) (Classe|BPDlgNPC|OttieniNTalents (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniMembers) (Utility|Operatori|Sottrai (Variabili|Predefinito|OttieniMemberIdx) 1))) (Utility|Operatori|Aggiungi (Utility|Operatori|Moltiplica K 18) 1)))
      (Utilità|Array|Add (Variabili|Predefinito|OttieniTalNames) (Classe|BPDlgNPC|OttieniTName (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniMembers) (Utility|Operatori|Sottrai (Variabili|Predefinito|OttieniMemberIdx) 1)))))))
