(fn AddBaseOpt (K)
  (Utilità|ControlloDiFlusso|Ramo (Utility|Operatori|Maggiore(>) (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniTBases) (Utility|Operatori|Aggiungi (Utility|Operatori|Aggiungi (Utility|Operatori|Moltiplica K (Utility|Operatori|Aggiungi (Utilità|Array|Length (Variabili|Predefinito|OttieniTTargetNames)) 1)) 1) (Variabili|Predefinito|OttieniTI))) 0.0)
    (:then
      (Utilità|Array|Add (Variabili|Predefinito|OttieniOptIds) (Matematica|Float|Truncate (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniTBases) (Utility|Operatori|Moltiplica K (Utility|Operatori|Aggiungi (Utilità|Array|Length (Variabili|Predefinito|OttieniTTargetNames)) 1)))))
      (Utilità|Array|Add (Variabili|Predefinito|OttieniOptNames) (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniTBaseNames) K)))))
