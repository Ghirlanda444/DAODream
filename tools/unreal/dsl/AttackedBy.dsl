(fn AttackedBy (Who)
  (Funzionedichiamata|ThreatSlot :Who Who)
  (Utilità|ControlloDiFlusso|Ramo (Utility|Operatori|Minore(<) (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniThreatVal) (Variabili|Predefinito|OttieniTIdx)) 1.0)
    (:then
      (Funzionedichiamata|AddThreat :Who Who :Amount 1.0))))
