(fn FindOne (K Ability)
  (Utilità|ControlloDiFlusso|Ramo (Matematica|Booleano|ANDBoolean (Utility|Operatori|Minore(<) (Variabili|Predefinito|OttieniTFound) 0) (Utility|Operatori|Uguale(==) (Utilità|Array|Ottieni(unacopia) (Variabili|Predefinito|OttieniNTalents) (Utility|Operatori|Aggiungi (Utility|Operatori|Moltiplica K 16) 0)) Ability))
    (:then
      (Variabili|Predefinito|ImpostaTFound K))))
